rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Isolasi data per-user: setiap pengguna hanya punya akses penuh pada
    // dokumen di dalam users/{uid}/... miliknya sendiri.
    //
    // Sudah diverifikasi empiris: permintaan tanpa token auth ke
    // users/{uid}/transaksi, /akun, dan /mutasiLog semuanya dijawab 403
    // PERMISSION_DENIED, termasuk percobaan tulis.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Semua jalur lain ditolak eksplisit. Tanpa aturan ini, penambahan
    // koleksi di luar users/ di masa depan akan terbuka secara diam-diam.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
