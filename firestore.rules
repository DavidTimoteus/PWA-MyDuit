rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Semua data MyDuit berada di bawah dokumen user masing-masing.
    // User hanya boleh membaca/menulis datanya sendiri.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tolak sisanya secara eksplisit (default memang deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
