rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolasi data per-user: setiap pengguna hanya memiliki akses penuh (baca/tulis)
    // pada dokumen yang berada di dalam sub-koleksi users/{uid}/... miliknya sendiri.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
