{
  "name": "pwa-myduit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MyDuit - PWA catatan keuangan pribadi (offline-first)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node serve-dist.mjs",
    "lint": "eslint src/",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "check:format": "node src/lib/format.check.mjs",
    "test:ocr": "node src/lib/ocrStruk.test.mjs",
    "test:filter": "node src/features/transaksi/mergeRiwayat.test.mjs",
    "test:riwayat": "node src/features/budget/riwayatSaldo.test.mjs",
    "test:render": "node src/features/budget/render.test.mjs",
    "test:events": "node src/lib/eventContract.test.mjs",
    "test:classes": "node src/styles/classContract.test.mjs",
    "test:utang": "node src/features/utang/prefill.test.mjs",
    "test:struk": "node src/lib/strukMeta.test.mjs",
    "check": "npm run check:format && npm run test:ocr && npm run test:struk && npm run test:offline && npm run test:filter && npm run test:riwayat && npm run test:render && npm run test:events && npm run test:classes && npm run test:utang && npm run lint && npm run build",
    "fb:login": "firebase login",
    "fb:rules": "firebase deploy --only firestore:rules",
    "fb:indexes": "firebase deploy --only firestore:indexes",
    "fb:firestore": "firebase deploy --only firestore",
    "test:offline": "node src/lib/offlineSync.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^12.18.0",
    "flatpickr": "^4.6.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas": "^3.2.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.28.2",
    "globals": "^15.0.0",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
