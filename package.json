{
  "name": "pwa-myduit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MyDuit - PWA catatan keuangan pribadi (offline-first)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node serve-dist.mjs",
    "lint": "eslint src/",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "check:format": "node src/lib/format.check.mjs",
    "check": "npm run check:format && npm run lint && npm run build",
    "fb:login": "firebase login",
    "fb:rules": "firebase deploy --only firestore:rules",
    "fb:indexes": "firebase deploy --only firestore:indexes",
    "fb:firestore": "firebase deploy --only firestore"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^12.18.0",
    "flatpickr": "^4.6.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.28.2",
    "globals": "^15.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
